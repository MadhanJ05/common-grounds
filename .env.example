# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string
DATABASE_URL=postgres://localhost:5432/common_grounds

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Public base URL of this app (used for the Log in with PayPal return URL)
APP_URL=http://localhost:3000

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "production"
PAYPAL_ENVIRONMENT=sandbox
# The browser SDK needs the client id too
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Claude API key (platform.claude.com)
ANTHROPIC_API_KEY=

# Lets you sign in as a seeded demo person without PayPal (for local dev and demo video).
# Set to "false" to hide it.
DEMO_LOGIN=true
